<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Nigutu" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/nigutu_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Nigutu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nigutu_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Nigutu</item>
    </style>
</resources>
